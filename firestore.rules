rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /transfers/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.receiverUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderUid;
    }

    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.members;
      // Update: Member dürfen alles ändern; Nicht-Member dürfen NUR sich
      // selbst zu members hinzufügen (Chat-Beitritt per Einladung).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
        )
      );

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── PublicScreen-Sessions ────────────────────────────────────
    match /public_screens/{sessionId} {
      allow get:    if true;
      allow list:   if false;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.adminUserId
            || exists(/databases/$(database)/documents/public_screens/$(sessionId)/joins/$(request.auth.uid)));

      // Admin-Secret: nur der Ersteller darf lesen/schreiben
      match /private/{doc} {
        allow read, write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/public_screens/$(sessionId)).data.adminUserId;
      }

      // Co-Admin-Beitritt: eigenes UID-Dokument, Secret muss stimmen
      match /joins/{uid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.secret ==
             get(/databases/$(database)/documents/public_screens/$(sessionId)/private/meta).data.adminSecret;
      }
    }
  }
}
